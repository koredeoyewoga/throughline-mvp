# Throughline Coordinate MVP — environment
# Everything runs with NO configuration. All values below are optional.

# --- Optional AI explanation layer -------------------------------------------
# The MVP ships a deterministic explanation/drafting engine and needs no API key.
# If you want the natural-language "why" and drafted actions to be generated by
# a model instead, set these. The model is used ONLY to phrase what the
# deterministic engine already detected — it never decides severity, never
# invents evidence, and must answer "Insufficient information available" when
# the supplied context is thin.
THROUGHLINE_AI_EXPLANATIONS=off        # off | on
ANTHROPIC_API_KEY=
THROUGHLINE_AI_MODEL=claude-sonnet-5

# --- Demo identity ----------------------------------------------------------
# The MVP has no real auth. Pick the role the UI starts in.
THROUGHLINE_DEFAULT_ROLE=coordinator  # coordinator | oversight

# --- Ingestion source (Phase 8 adapters) ----------------------------------
# Where events come from. Default `synthetic` uses the built-in seed and needs
# nothing else. All adapters are READ-ONLY — nothing is written back to a
# source system. After setting these, use "Pull from source" on /settings or
# POST /api/ingest.
THROUGHLINE_SOURCE=synthetic          # synthetic | fhir | ers | toc

# fhir: live FHIR R4 read adapter. Works against the public HAPI test server.
THROUGHLINE_FHIR_BASE_URL=            # e.g. https://hapi.fhir.org/baseR4
THROUGHLINE_FHIR_PATIENT=             # optional: a Patient/{id} or an NHS number to scope the sweep
THROUGHLINE_FHIR_TOKEN=              # optional: bearer token if the endpoint needs one

# ers / toc: map a captured test payload (no HSCN connection needed).
THROUGHLINE_ERS_FILE=                 # path to a JSON array of e-RS Referral Requests
THROUGHLINE_TOC_FILE=                 # path to a JSON Transfer-of-Care document (or array)
